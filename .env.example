# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public URL of this instance, without a trailing slash.
APP_URL=http://localhost:3000

# Long random string. Used to encrypt tokens and API keys at rest and to sign
# OAuth state. Generate one with: openssl rand -hex 32
APP_SECRET=

# Postgres connection string. docker-compose.yml sets this for you.
DATABASE_URL=postgres://omakaze:omakaze@localhost:5432/omakaze

# ---------------------------------------------------------------------------
# GitHub App (recommended). Leave empty and use /admin to create the app with
# one click, or fill these in from an existing app. See docs/github-app.md.
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM contents; newlines may be written as \n.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Enterprise Server: set both.
# GITHUB_URL=https://github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3

# Secret for repository webhooks created from the Repositories page (token and
# linked-account connections). Defaults to a value derived from APP_SECRET.
# GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
AUTH_EMAIL_ENABLED=true
# Allow signing in with a GitHub personal access token (useful without a GitHub App).
AUTH_GITHUB_TOKEN_ENABLED=false
# false = invite-only (the first account can always be created).
AUTH_SIGNUP_ENABLED=true
# Comma-separated list, e.g. example.com,example.org
# AUTH_ALLOWED_EMAIL_DOMAINS=
# Reverse proxies in front of the app that append to X-Forwarded-For (used to find the
# client address for rate limits). Without a proxy, clients can set that header themselves.
# TRUST_PROXY_HOPS=1

# Email for invites and notifications (optional). Without it, invites are shared as
# links and email notifications are off.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=Omakaze <omakaze@example.com>

# Notifications: email, Slack and JSON webhooks (false turns all of them off).
# NOTIFICATIONS_ENABLED=true
# Seconds the first email notification waits for others, so they arrive as one email.
# NOTIFICATIONS_GROUP_SECONDS=300
# Let Slack and JSON webhooks reach private network addresses (e.g. Mattermost on your network).
# WEBHOOKS_ALLOW_PRIVATE_NETWORK=false

# ---------------------------------------------------------------------------
# Built-in AI generation (optional; workspaces can set their own in Settings → AI)
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic         # anthropic | openai | google | openrouter | ollama | lmstudio | openai-compatible
# AI_MODEL=claude-opus-5-5
# AI_API_KEY=                   # optional for ollama, lmstudio and openai-compatible
# AI_BASE_URL=                  # e.g. http://ollama:11434/v1 for ollama in Docker Compose
# CHATGPT_PLAN_ENABLED=true     # users can connect their own ChatGPT plan (workspaces opt in)

# ---------------------------------------------------------------------------
# Storage and background work
# ---------------------------------------------------------------------------
# database (default) stores uploads in Postgres; filesystem writes to STORAGE_DIR.
STORAGE_DRIVER=database
# STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=50

# The worker runs inside the app process. Set POLL_INTERVAL_SECONDS=0 to rely on webhooks only.
WORKER_ENABLED=true
POLL_INTERVAL_SECONDS=300

# Behind an HTTP proxy, make Node's fetch use HTTP(S)_PROXY:
# NODE_USE_ENV_PROXY=1

# Serve only the landing page (no database, sign-in or worker), e.g. for a
# marketing deploy on Vercel. Every other page redirects to /.
# LANDING_ONLY=true
