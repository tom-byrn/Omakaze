{
  "name": "@hearth/server",
  "version": "0.1.0",
  "private": true,
  "description": "Hearth API server: Express 5 on top of node:sqlite.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --disable-warning=ExperimentalWarning src/index.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "db:migrate": "tsx --disable-warning=ExperimentalWarning db/cli.ts migrate",
    "db:seed": "tsx --disable-warning=ExperimentalWarning db/cli.ts seed",
    "db:reset": "tsx --disable-warning=ExperimentalWarning db/cli.ts reset",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hearth/shared": "workspace:*",
    "express": "^5.1.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3"
  }
}
